# Alles hieronder is OPTIONEEL. Zonder .env draait de workspace volledig lokaal:
# ingebouwde database, bestanden en browserprofiel in ./data, sleutel automatisch aangemaakt.

# --- Opslag -----------------------------------------------------------------
# Map met al je gegevens (database, versleutelde bestanden, browserprofiel, sleutel).
# DATA_DIR=./data
# Alleen voor team/server-gebruik: PostgreSQL-server i.p.v. de ingebouwde database.
# DATABASE_URL=postgres://workspace:workspace@localhost:5432/ai_workspace
# Eigen encryptiesleutel (32 bytes, base64). Leeg = automatisch in DATA_DIR/encryption.key
# ENCRYPTION_KEY=

# --- Browser-tools (fase 1: geen API's) --------------------------------------
# ENABLE_BROWSER_PROVIDER=true
# chrome | msedge | leeg (= ingebouwde Chromium). Het startprogramma kiest dit automatisch.
# BROWSER_CHANNEL=chrome
# BROWSER_HEADLESS=false
# BROWSER_ANSWER_TIMEOUT_SEC=300
# Selectors overschrijven als een site verandert (zie docs/BROWSER-TOOLS.md):
# BROWSER_SITES_FILE=./browser-sites.json

# --- API's (fase 2, pas als alles stabiel is) ----------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# PERPLEXITY_API_KEY=

# --- Overig -----------------------------------------------------------------
# DEFAULT_MODEL_ID=browser:perplexity
# SESSION_TTL_HOURS=12
# MAX_UPLOAD_MB=10
# MAX_CONTEXT_CHARS=200000
# Offline testmodel (echo), handig voor demo's:
# ENABLE_MOCK_PROVIDER=false
# Poort (standaard 3000, of de eerstvolgende vrije):
# PORT=3000
