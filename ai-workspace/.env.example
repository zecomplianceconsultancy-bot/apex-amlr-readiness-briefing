# --- Core ---------------------------------------------------------------
DATABASE_URL=postgres://workspace:workspace@localhost:5432/ai_workspace
# Public origin of the app; used for CSRF origin checks.
APP_ORIGIN=http://localhost:3000

# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts uploaded files at rest. Losing it means losing access to stored files.
ENCRYPTION_KEY=

# Local directory for encrypted file blobs (storage driver "local").
STORAGE_DIR=./storage

# Session lifetime in hours.
SESSION_TTL_HOURS=12

# --- AI providers (server-side only; never exposed to the browser) ---------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Offline echo provider for development and demos without API keys.
ENABLE_MOCK_PROVIDER=true

# Default model id from the registry (src/server/ai/registry.ts).
DEFAULT_MODEL_ID=anthropic:claude-opus-5

# --- Limits ---------------------------------------------------------------
MAX_UPLOAD_MB=10
# Upper bound on characters of project files injected into a single prompt.
MAX_CONTEXT_CHARS=200000
