# --- Core ---------------------------------------------------------------
DATABASE_URL=postgres://workspace:workspace@localhost:5432/ai_workspace
# Public origin of the app; used for CSRF origin checks.
APP_ORIGIN=http://localhost:3000

# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts uploaded files at rest. Losing it means losing access to stored files.
ENCRYPTION_KEY=

# Local directory for encrypted file blobs (storage driver "local").
STORAGE_DIR=./storage

# Session lifetime in hours.
SESSION_TTL_HOURS=12

# --- AI providers (server-side only; never exposed to the browser) ---------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Offline echo provider for development and demos without API keys.
ENABLE_MOCK_PROVIDER=true

# --- Browser tools (fase 1: geen API's) --------------------------------------
# The app drives Perplexity / ChatGPT / Claude / Gemini through their normal web UI in a
# browser window on THIS machine. Run the app on your own desktop. See docs/BROWSER-TOOLS.md.
ENABLE_BROWSER_PROVIDER=true
# Browser profile where you log in once per tool. Contains session cookies: keep it private.
BROWSER_PROFILE_DIR=./.browser-profile
# chrome | msedge | (empty = Playwright's bundled Chromium)
BROWSER_CHANNEL=chrome
BROWSER_HEADLESS=false
BROWSER_ANSWER_TIMEOUT_SEC=300
# Optional selector overrides when a site changes its layout:
# BROWSER_SITES_FILE=./browser-sites.json

# Default model id from the registry (src/server/ai/registry.ts).
DEFAULT_MODEL_ID=browser:perplexity

# --- Limits ---------------------------------------------------------------
MAX_UPLOAD_MB=10
# Upper bound on characters of project files injected into a single prompt.
MAX_CONTEXT_CHARS=200000
